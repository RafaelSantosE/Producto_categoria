@model IEnumerable<Producto_categoria.Models.Product>

@{
    ViewData["Title"] = "Productos";
    var culturaCol = new System.Globalization.CultureInfo("es-CO");
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Productos</h1>
            <p class="page-sub">Administra el inventario global de la plataforma.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Crear nuevo producto
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3>No hay productos registrados</h3>
            <p>Comienza a agregar productos al catálogo de tu tienda.</p>
            <a class="btn btn-primary" asp-action="Create">Agregar producto</a>
        </div>
    }
    else
    {
        <div class="grid-products">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image">
                        <span class="product-initial">
                            @(string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name[0].ToString().ToUpper())
                        </span>
                    </div>
                    <div class="product-body">
                        <span class="product-badge">
                            @(item.Category?.Name ?? "Sin categoría")
                        </span>
                        <h3 class="product-title">@(item.Name ?? "Sin nombre")</h3>
                        <div class="product-footer">
                            <span class="price-label">Precio</span>
                            <span class="product-price">@item.Price.ToString("C0", culturaCol)</span>
                        </div>
                        <div class="card-actions list-actions-margin">
                            <a class="btn-action edit" asp-action="Edit" asp-route-id="@item.ProductId">Editar</a>
                            <a class="btn-action details" asp-action="Details" asp-route-id="@item.ProductId">Detalles</a>
                            <a class="btn-action delete" asp-action="Delete" asp-route-id="@item.ProductId">Eliminar</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>