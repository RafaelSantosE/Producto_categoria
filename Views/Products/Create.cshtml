@model Producto_categoria.Models.Product

@{
    ViewData["Title"] = "Crear producto";
}

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <h2>Crear producto</h2>
            <p>Ingresa la información requerida para registrar un nuevo producto.</p>
        </div>

        <form asp-action="Create" class="styled-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label">Nombre del producto</label>
                <input asp-for="Name" class="form-input" placeholder="Ej: Computador portátil" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="form-label">Precio</label>
                <input asp-for="Price" class="form-input" placeholder="Ej: 1500000" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="form-label">Categoría</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                    <option value="">-- Seleccionar categoría --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a class="btn btn-secondary-outline" asp-action="Index">Volver</a>
                <button type="submit" class="btn btn-primary">Crear producto</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}