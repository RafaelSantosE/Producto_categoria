@model Producto_categoria.Models.HomeViewModel

@{
    ViewData["Title"] = "Inicio";
    var culturaCol = new System.Globalization.CultureInfo("es-CO");
}

@section Hero {
    <div class="hero-container">
        <div class="hero-content">
            <span class="badge-hero">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                Gestión de Inventario
            </span>
            <h1>Cada producto en su lugar exacto.</h1>
            <p class="lead">Optimiza el catálogo de <strong>Tienda Don Juan</strong>. Controla categorías, administra existencias y accede a tus métricas en segundos.</p>
            <div class="hero-actions">
                <a class="btn btn-primary" asp-controller="Products" asp-action="Create">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Agregar producto
                </a>
                <a class="btn btn-secondary" asp-controller="Categories" asp-action="Index">Ver categorías</a>
            </div>
        </div>
    </div>
}

<!-- SECCIÓN DE MÉTRICAS -->
<div class="stats-wrapper">
    <div class="stat-card">
        <div class="stat-icon icon-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /></svg>
        </div>
        <div class="stat-data">
            <span class="stat-value">@Model.TotalProductos</span>
            <span class="stat-label">@(Model.TotalProductos == 1 ? "Producto registrado" : "Productos registrados")</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
        </div>
        <div class="stat-data">
            <span class="stat-value">@Model.TotalCategorias</span>
            <span class="stat-label">@(Model.TotalCategorias == 1 ? "Categoría activa" : "Categorías activas")</span>
        </div>
    </div>

    @if (Model.SinCategoria > 0)
    {
        <div class="stat-card warning">
            <div class="stat-icon icon-amber">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            </div>
            <div class="stat-data">
                <span class="stat-value">@Model.SinCategoria</span>
                <span class="stat-label">Sin categoría asignada</span>
            </div>
        </div>
    }
</div>

<!-- SECCIÓN CATEGORÍAS -->
<section class="main-section">
    <div class="section-header">
        <div>
            <h2>Categorías destacadas</h2>
            <p class="section-sub">Explora los grupos de productos organizados en tu tienda.</p>
        </div>
        <a class="link-arrow" asp-controller="Categories" asp-action="Index">
            Ver todas
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
    </div>

    @if (Model.Categorias == null || !Model.Categorias.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📂</div>
            <h3>Sin categorías creadas</h3>
            <p>Comienza creando categorías para organizar mejor tus productos.</p>
            <a class="btn btn-primary" asp-controller="Categories" asp-action="Create">Crear primera categoría</a>
        </div>
    }
    else
    {
        <div class="grid-categories">
            @foreach (var c in Model.Categorias)
            {
                <a class="category-card" asp-controller="Categories" asp-action="Details" asp-route-id="@c.Id">
                    <div class="cat-avatar">@(string.IsNullOrWhiteSpace(c.Nombre) ? "?" : c.Nombre[0].ToString().ToUpper())</div>
                    <div class="cat-info">
                        <h4>@(c.Nombre ?? "Sin nombre")</h4>
                        <span>@c.Total @(c.Total == 1 ? "producto" : "productos")</span>
                    </div>
                </a>
            }
        </div>
    }
</section>

<!-- SECCIÓN ÚLTIMOS PRODUCTOS -->
<section class="main-section">
    <div class="section-header">
        <div>
            <h2>Últimos productos</h2>
            <p class="section-sub">Artículos agregados recientemente a la plataforma.</p>
        </div>
        <a class="link-arrow" asp-controller="Products" asp-action="Index">
            Ver catálogo completo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
    </div>

    @if (Model.UltimosProductos == null || !Model.UltimosProductos.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3>Tu inventario está vacío</h3>
            <p>Agrega productos para dar vida a la tienda.</p>
            <a class="btn btn-primary" asp-controller="Products" asp-action="Create">Agregar producto</a>
        </div>
    }
    else
    {
        <div class="grid-products">
            @foreach (var p in Model.UltimosProductos)
            {
                <a class="product-card" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId">
                    <div class="product-image">
                        <span class="product-initial">@(string.IsNullOrWhiteSpace(p.Name) ? "?" : p.Name[0].ToString().ToUpper())</span>
                    </div>
                    <div class="product-body">
                        <span class="product-badge">@(p.Category?.Name ?? "Sin categoría")</span>
                        <h3 class="product-title">@(p.Name ?? "Sin nombre")</h3>
                        <div class="product-footer">
                            <span class="price-label">Precio</span>
                            <span class="product-price">@p.Price.ToString("C0", culturaCol)</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<!-- CALL TO ACTION FINAL -->
<div class="cta-banner">
    <div class="cta-content">
        <h2>¿Necesitas clasificar más productos?</h2>
        <p>Añade categorías para mantener el control completo de tu stock.</p>
        <a class="btn btn-primary btn-large" asp-controller="Categories" asp-action="Create">
            Crear nueva categoría
        </a>
    </div>
</div>