@model Producto_categoria.Models.Category

@{
    ViewData["Title"] = "Crear categoría";
}

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <h2>Crear categoría</h2>
            <p>Ingresa el nombre para añadir una nueva categoría al sistema.</p>
        </div>

        <form asp-action="Create" class="styled-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label">Nombre de la categoría</label>
                <input asp-for="Name" class="form-input" placeholder="Ej: Electrónica" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a class="btn btn-secondary-outline" asp-action="Index">Volver</a>
                <button type="submit" class="btn btn-primary">Crear categoría</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}